manifest {
    name = 'hmp_project'
    description = 'Pipeline for the BIO 4432 project'
    mainScript = 'workflows/main.nf'
    nextflowVersion = '>=26.04.6'
}

params {
    // Template input; replace with the real pipeline's parameters.
    names = 'world'

    // Which stage to run: 'pipeline' (the analysis) or 'data' (compile data/derived/).
    stage = 'pipeline'

    // Data compilation. The project CLI builds the committed tables in data/derived/;
    // see docs/data/README.md. `cli` is how a task reaches it, through Pixi's default
    // environment. Spelled as a command rather than as the `sync` and `extract` Pixi
    // tasks, because a named task runs in the workspace root while a command runs where
    // it was called: the task directory, which is where the catalog has to land.
    cli = "pixi run --manifest-path ${projectDir}/../pyproject.toml python -m hmp_project"
    sra_metadata_spec = "${projectDir}/../manifests/sra-metadata-freeze.json"
    hmp_sample_locks = "${projectDir}/../manifests/hmp-{stool,subgingival-plaque,tongue-dorsum}.lock.json"
    hmp_sra_runs_table = 'hmp-sra-runs.tsv'

    // SLURM partition and account; leave null to use the cluster defaults.
    slurm_queue = null
    slurm_account = null
}

// The data stage rebuilds committed tables, so it publishes into the working tree; the
// pipeline publishes into results/ as usual.
outputDir = params.stage == 'data' ? "${projectDir}/../data" : 'results'

includeConfig 'conf/base.config'
includeConfig 'conf/containers.config'

profiles {
    slurm {
        includeConfig 'conf/slurm.config'
    }
    apptainer {
        includeConfig 'conf/apptainer.config'
    }
    docker {
        includeConfig 'conf/docker.config'
    }
}
