manifest {
    name = 'hmp_project'
    description = 'Pipeline for the BIO 4432 project'
    mainScript = 'workflows/main.nf'
    nextflowVersion = '>=26.04.6'
}

params {
    // Which stage to run: 'preprocess' (compile data/derived/) or 'pipeline' (the
    // analysis). The default is the analysis on purpose: preprocessing writes into the
    // working tree, so it is asked for by name rather than entered by running the
    // pipeline with no arguments.
    stage = 'pipeline'

    // Preprocessing. The project CLI builds the committed tables in data/derived/; see
    // docs/data/README.md. `cli` is how a task reaches it inside the stage's image,
    // where the package is installed and on the default path.
    cli = 'python -m hmp_project'
    sra_metadata_spec = "${projectDir}/../manifests/sra-metadata-freeze.json"
    hmp_sample_locks = "${projectDir}/../manifests/hmp/{stool,subgingival-plaque,tongue-dorsum}.lock.json"
    hmp_sra_runs_table = 'hmp-sra-runs.tsv'
    salter_study = 'ERP006808'
    salter_runs_table = 'salter-runs.tsv'

    // Which part of the stage runs. The tables need a 2.3 GB metadata freeze and the
    // catalog needs up to a gigabyte of genomes, so asking for one and getting both is
    // an expensive accident.
    preprocess = 'all'

    // The TR locus catalog. `trf` is inTRuder's finder, as installed in the catalog
    // image. The four finder settings are exposed because they are not settled: the
    // `genome` profile is provisional (submodules/inTRuder/.../trf/params.py), and
    // choosing it means enumerating the grid rather than trusting a default. null leaves
    // the profile's own value in place.
    trf = 'trf'
    catalog_spec = "${projectDir}/../manifests/hmp/mock-community.json"
    catalog_profile = 'genome'
    catalog_min_identity = null
    catalog_min_seed_units = null
    catalog_min_seed_length = null
    // How far the finder may extend a call past its seed. The profile's 20 inflates a
    // planted tract's length by absorbed flank (trf/params.py), which is noise in the very
    // allele lengths §4 measures, so it is chosen from the sweep before anything else.
    catalog_max_extension = null
    // Where the assembly name comes from: 'dir' for HMP, which puts the organism in the
    // directory and a nondescript accession in the file name; 'file' for one genome per
    // file, which is how the slacken specs arrive.
    catalog_genome_from = 'dir'
    catalog_table = 'tr-catalog.tsv'
    catalog_bed = 'tr-catalog.bed'

    // `--preprocess sweep` instead: loci found per grid point, for choosing the
    // thresholds above. Space-separated because the task iterates them in a shell loop.
    // One task covers the whole grid, so the genomes are synced once rather than once
    // per point -- see workflows/modules/preprocess/tr_sweep.nf.
    //
    // The seed lengths are chosen around the two thresholds interacting, not spaced
    // evenly. A seed has to clear min_seed_length as well as min_seed_units, so the
    // binding constraint on a motif of length m is max(min_seed_units, ceil(L/m)) units:
    // min_seed_units is inert wherever min_seed_length asks for more. With 3 units that
    // puts the cliffs at L <= 9 for a trinucleotide and L <= 6 for a dinucleotide, which
    // is why 10 -> 9 and 7 -> 6 matter and 12 -> 10 does almost nothing. 12 is here
    // because it is the `genome` profile's own value, so the grid brackets the catalog
    // that params.catalog_profile actually builds.
    //
    // min_seed_units stays on the grid because inert is not the same as redundant: it
    // differs from 3 to 2 only for motifs of 6 bp and up at L=12, 5 and up at L=10 or 9,
    // and 3 and up at L=6. The two floors govern disjoint motif lengths rather than the
    // same yield, which is what the motif bands in the sweep table measure.
    //
    // Both axes bracket the profile on the strict side as well as the loose one, so the
    // grid can say whether the profile's own values are too permissive and not only how
    // much looser ones would admit. 0.9 matters because purity piles up against the 0.8
    // gate -- a median of 0.83 on the mock community -- which is the signature of a
    // threshold that is binding rather than slack.
    //
    // max_extension leads because it changes call boundaries, not just yield: 0 reports a
    // tract exactly but truncates it at its first substitution, 20 is the profile's value,
    // and from about 100 up the identity gate rejects everything. Each value multiplies
    // the grid, and the grid runs once per genome, so on the 198 target genomes keep the
    // other axes short (one value each) while this one is being chosen.
    sweep_max_extensions = '0 10 20'
    sweep_identities = '0.9 0.8 0.7'
    sweep_seed_units = '3 2'
    sweep_seed_lengths = '15 12 10 9 8 6'
    sweep_table = 'tr-sweep.tsv'

    // The pipeline stage: HMP reads streamed from S3 through a k-mer gate built from the
    // TR catalog. See docs/workflows/pipeline/README.md. `--pipeline` picks the part:
    // 'loci' (the gate's reference), 'filter' (one task per sample), 'summary', or 'all'.
    pipeline = 'all'

    // The gate's reference: every catalog locus, padded by `filter_flank` bases each side,
    // from the genomes of `catalog_spec` above. The stage builds the catalog itself with
    // the `catalog_*` settings unless `loci_catalog` names an existing one, such as the
    // table `--stage preprocess --preprocess catalog` publishes.
    loci_catalog = null
    loci_fasta = 'tr-loci.fa'
    filter_flank = 50

    // Which samples stream. Comma-separated body sites, each a lockfile under
    // manifests/hmp/; the default is plaque, the 7-sample pilot that measures the pass
    // fraction before the 267 stool and tongue samples are committed to. A glob in
    // `filter_sample_locks` overrides the body sites outright.
    filter_body_sites = 'subgingival-plaque'
    filter_sample_locks = null

    // bbduk's k-mer length and Hamming distance, and its threads: the rest of a task's
    // cores go to the decompressor. lbzip2 matches bzip2 byte for byte on HMP's files and
    // is many times faster (docs/workflows/pipeline/); 'bzip2' remains as a fallback.
    filter_k = 25
    filter_hdist = 1
    filter_threads = 2
    filter_decompressor = 'lbzip2'
    // Hits written per sample before writing stops, as a disk valve; counting goes on,
    // so the summary still reports the true pass fraction. null for no cap.
    filter_max_reads = null
    filter_summary_table = 'filter-summary.tsv'

    // SLURM partition and account; leave null to use the cluster defaults.
    slurm_queue = null
    slurm_account = null

    // Push notifications, handled in workflows/modules/notify.nf. Off unless a topic is
    // set: a topic name is the only thing guarding an ntfy channel, so it never lives in
    // a committed file. Both fall through to the git-ignored .env when unset here, which
    // is where a clone is meant to keep them; notify.nf resolves that and holds the
    // default server.
    ntfy_topic = System.getenv('NTFY_TOPIC')
    ntfy_server = System.getenv('NTFY_SERVER')
}

// Preprocessing rebuilds committed tables, so it publishes into the working tree; the
// analysis publishes into results/ as usual.
outputDir = params.stage == 'preprocess' ? "${projectDir}/../data" : 'results'

// pipefail, which Nextflow's default `bash -ue` leaves off: without it a pipe's status
// is its last command's, so a download dying mid-pipe hands a truncated stream on as if
// it were whole.
process.shell = ['/bin/bash', '-euo', 'pipefail']

includeConfig 'conf/base.config'
includeConfig 'conf/containers.config'

profiles {
    slurm {
        includeConfig 'conf/slurm.config'
    }
    apptainer {
        includeConfig 'conf/apptainer.config'
    }
    docker {
        includeConfig 'conf/docker.config'
    }
}
