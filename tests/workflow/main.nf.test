nextflow_pipeline {

    name "Pipeline"
    script "workflows/main.nf"

    // Only the stage branching is tested here. A run of the preprocessing stage itself is
    // covered by the process test, which is stubbed: the stage publishes into the working
    // tree through `outputDir`, which is not somewhere a test should write.
    test("stops when the stage does not exist") {
        when {
            params {
                stage = 'nonsense'
            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.any { it.contains("unknown --stage 'nonsense'") }
        }
    }

    test("stops when the analysis stage is asked for") {
        when {
            params {
                stage = 'pipeline'
            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.any { it.contains('has no analysis yet') }
        }
    }
}
