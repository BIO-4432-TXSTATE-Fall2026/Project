nextflow_process {

    name "SRA_RUN_METADATA"
    script "workflows/modules/preprocess/sra_metadata.nf"
    process "SRA_RUN_METADATA"

    // Stubbed: the real script syncs a 2.3 GB catalog from S3. This checks the wiring,
    // that every manifest the extract needs is staged and both tables come back named.
    test("emits both named tables") {
        options "-stub"

        when {
            process {
                """
                input[0] = file("${projectDir}/manifests/sra-metadata-freeze.json")
                input[1] = file("${projectDir}/manifests/sra-metadata-freeze.lock.json")
                input[2] = files("${projectDir}/manifests/hmp-{stool,subgingival-plaque,tongue-dorsum}.lock.json")
                input[3] = 'hmp-sra-runs.tsv'
                input[4] = 'ERP006808'
                input[5] = 'salter-runs.tsv'
                """
            }
        }

        then {
            assert process.success
            assert process.out.hmp[0].endsWith('hmp-sra-runs.tsv')
            assert path(process.out.hmp[0]).text.startsWith('run\tsample\tstudy')
            assert process.out.salter[0].endsWith('salter-runs.tsv')
            // The kit and dilution columns are what the Salter table exists for.
            assert path(process.out.salter[0]).text.contains('kit\tdilution')
        }
    }
}
