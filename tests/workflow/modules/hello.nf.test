nextflow_process {

    name "HELLO"
    script "workflows/modules/hello.nf"
    process "HELLO"

    test("writes a greeting for the name") {
        when {
            process {
                """
                input[0] = 'world'
                """
            }
        }

        then {
            assert process.success
            assert path(process.out[0][0]).text == "Hello, world!\n"
        }
    }
}
