// Default resources for every process, whatever the executor.
process {
    cpus = 1
    memory = 2.GB
    time = 1.h

    // Retry once on out-of-memory and other kills a scheduler reports as 137-140.
    errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
    maxRetries = 1

    // Streaming one sample: lbzip2 on four cores and bbduk on two, which keep pace with
    // each other at HMP's ~23 MB/s per bzip2 core. bbduk's k-mer table is most of the
    // memory. Hours, because a 2 GB tarball is ~8 GB of FASTQ through one pipe.
    //
    // Any failure retries, not just a scheduler kill: a dropped S3 connection is the
    // likeliest one here, and it is transient. A filter failure is never a partial
    // success -- `filter` publishes nothing unless every stage exited cleanly.
    withLabel: 'stream' {
        cpus = 6
        memory = 16.GB
        time = 4.h
        errorStrategy = 'retry'
        maxRetries = 2
    }

    // Preprocessing: one core, but hours of downloading, and the catalog sits in the
    // task directory while it runs. Give the work filesystem room for it.
    withLabel: 'preprocess' {
        memory = 4.GB
        time = 8.h
    }

    // Cataloging: the download dominates, then one finder pass per genome. 314 target
    // genomes at a few seconds each is minutes, not hours, but the genomes sit in the
    // task directory while it runs -- up to a gigabyte for one spec.
    withLabel: 'catalog' {
        memory = 4.GB
        time = 4.h
    }

    // Screening the loci against a genome spec: shred and bbduk in one pipe, which keep
    // pace with each other on a few cores. bbduk's k-mer table is most of the memory: about 47k
    // loci at k 25 and hdist 1 need a heap of ~12 GB, and shred holds whole chromosomes.
    // Hours, because CHM13 is 3.1 Gbp and the screen matches at hdist 1.
    withLabel: 'screen' {
        cpus = 4
        memory = 32.GB
        time = 12.h
    }

    // Spike-ins: simulating reads from thirty genomes at three depths, then gating each file
    // and mixing the alleles into every host. The mix holds one host-and-genome table at a
    // time but reads all of them, so it wants more than the default.
    withLabel: 'spike' {
        cpus = 2
        memory = 16.GB
        time = 4.h
    }
}
