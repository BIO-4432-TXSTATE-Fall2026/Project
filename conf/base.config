// Default resources for every process, whatever the executor.
process {
    cpus = 1
    memory = 2.GB
    time = 1.h

    // Retry once on out-of-memory and other kills a scheduler reports as 137-140.
    errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'finish' }
    maxRetries = 1

    // Preprocessing: one core, but hours of downloading, and the catalog sits in the
    // task directory while it runs. Give the work filesystem room for it.
    withLabel: 'preprocess' {
        memory = 4.GB
        time = 8.h
    }
}
