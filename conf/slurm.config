// Submit each task as a SLURM job. Needs a filesystem shared between the submit and
// compute nodes for the work directory and containers.
process {
    executor = 'slurm'
    queue = params.slurm_queue
    clusterOptions = params.slurm_account ? "--account=${params.slurm_account}" : ''

    // One SLURM job array per batch of samples rather than an sbatch per sample: 274
    // samples are a handful of submissions, which the scheduler and the submit limit
    // below both prefer.
    withLabel: 'stream' {
        array = 50
    }
}

executor {
    queueSize = 50
    pollInterval = '30 sec'
    submitRateLimit = '10/1min'
}
