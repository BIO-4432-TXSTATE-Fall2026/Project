// Images built from containers/<stage>.Dockerfile and published to GHCR by
// .github/workflows/containers.yml. Ignored unless a container profile is enabled.
//
// One image per stage: every process in a stage carries that stage's label, so the
// mapping is by label rather than by process name and a new process in the stage needs
// no entry here.
process {
    withLabel: 'preprocess' {
        container = 'ghcr.io/bio-4432-txstate-fall2026/project/preprocess:latest'
    }
    // Cataloging needs the repeat finder as well as the CLI, which the preprocess image
    // does not carry: pytrf is a C extension and that image installs from PyPI.
    withLabel: 'catalog' {
        container = 'ghcr.io/bio-4432-txstate-fall2026/project/catalog:latest'
    }
}
